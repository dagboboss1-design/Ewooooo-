# Keep real credentials private in your hosting environment; never commit them.
MARKET_DATA_PROVIDER=twelve_data
TWELVE_DATA_API_KEY=
TWELVE_DATA_SYMBOLS=EUR/USD,GBP/USD,USD/JPY,AUD/USD,USD/CAD,EUR/GBP,AUD/NZD,XAU/USD,XAG/USD,BTC/USD

# Optional legacy OANDA provider
OANDA_ENVIRONMENT=practice
OANDA_PRACTICE_TOKEN=
OANDA_LIVE_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_INSTRUMENTS=EUR_USD,GBP_USD,USD_JPY,AUD_USD,USD_CAD,EUR_GBP,AUD_NZD,XAU_USD,XAG_USD,BTC_USD
OANDA_GRANULARITY=H1
OANDA_PRICE_COMPONENT=MBA

# AI chat; API billing is separate from a ChatGPT subscription.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/metadata.db
LIVE_TRADING=false
