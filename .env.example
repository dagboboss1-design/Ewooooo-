# OANDA market-data environment: practice or live
OANDA_ENVIRONMENT=practice
OANDA_PRACTICE_TOKEN=
OANDA_LIVE_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_INSTRUMENTS=EUR_USD,GBP_USD,USD_JPY,AUD_USD,USD_CAD,EUR_GBP,AUD_NZD
OANDA_GRANULARITY=H1
OANDA_PRICE_COMPONENT=MBA

DATA_DIR=./data
DATABASE_URL=sqlite:///./data/metadata.db

BIQUOTE_CALENDAR_URL=https://biquote.io/api/calendar/upcoming
BIQUOTE_IMPORTANCE=high
BIQUOTE_COUNTRIES=US,EU,GB,JP,AU,CA,NZ,CH

GDELT_DOC_URL=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_QUERY=(forex OR currency OR central bank OR interest rate)
GDELT_LOOKBACK_MINUTES=180

# Phase 1 never submits orders. Keep false.
LIVE_TRADING=false
