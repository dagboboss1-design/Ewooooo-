# Store real credentials only in your private server/deployment environment.
# Never commit real API keys to Git.
OANDA_ENVIRONMENT=practice
OANDA_PRACTICE_TOKEN=
OANDA_LIVE_TOKEN=
OANDA_ACCOUNT_ID=
